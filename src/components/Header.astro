---
import { Image } from 'astro:assets';
import logo from '../assets/logo-wordmark.png';
import Icon from './Icon.astro';
import { LANDINGS } from '../data/pages';
import { BRICKS } from '../data/pricing';
const briques = LANDINGS.filter((l) => l.kind === 'brique');
const atouts = LANDINGS.filter((l) => l.kind === 'atout');
const desc = (id?: string) => BRICKS.find((b) => b.id === id)?.desc;
const path = Astro.url.pathname;
---
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="site-header">
  <div class="bar">
    <a href="/" class="logo" aria-label="Stagnum, accueil">
      <Image src={logo} alt="Stagnum" width={128} height={25} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="nav" aria-label="Navigation principale">
      <div class="drop">
        <button type="button" class="drop-btn" aria-expanded="false" aria-controls="menu-fonctions">Fonctionnalités</button>
        <div id="menu-fonctions" class="mega">
          <div class="mega-col">
            <p class="mega-title">Les briques</p>
            <ul class="mega-grid">
              {briques.map((f) => (
                <li>
                  <a href={`/${f.slug}/`} aria-current={path === `/${f.slug}/` ? 'page' : undefined}>
                    <span class="m-ic"><Icon name={f.brick!} size={20} /></span>
                    <span><strong>{f.nav}</strong><small>{desc(f.brick)}</small></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="mega-side">
            <p class="mega-title">Inclus, sans supplément</p>
            <ul>
              {atouts.map((f) => (
                <li>
                  <a href={`/${f.slug}/`} aria-current={path === `/${f.slug}/` ? 'page' : undefined}>
                    <strong>{f.nav}</strong>
                    <small>{f.withBricks}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <a href="/tarifs/" aria-current={path === '/tarifs/' ? 'page' : undefined}>Tarifs</a>
      <a href="/alternative-extrabat/" aria-current={path === '/alternative-extrabat/' ? 'page' : undefined}>Comparer</a>
      <a href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
    </nav>
    <a href="/tarifs/" class="btn btn-primary cta">Calculer mon tarif</a>
    <details class="mobile">
      <summary aria-label="Menu"><span></span></summary>
      <nav aria-label="Navigation mobile">
        <p class="m-title">Les briques</p>
        <div class="m-grid">
          {briques.map((f) => (
            <a href={`/${f.slug}/`} aria-current={path === `/${f.slug}/` ? 'page' : undefined}>
              <span class="m-ic"><Icon name={f.brick!} size={18} /></span>{f.nav.split(' et ')[0]}
            </a>
          ))}
        </div>
        <p class="m-title">Inclus, sans supplément</p>
        <div class="m-chips">
          {atouts.map((f) => <a href={`/${f.slug}/`}>{f.nav}</a>)}
        </div>
        <div class="m-links">
          <a href="/tarifs/">Tarifs</a>
          <a href="/alternative-extrabat/">Comparer</a>
          <a href="/blog/">Blog</a>
        </div>
        <a href="/tarifs/" class="btn btn-primary">Calculer mon tarif</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Écouteurs posés sur le document : ils restent valables même si la page est mise à jour sans rechargement.
  const set = (open: boolean) => {
    document.querySelector('.drop')?.classList.toggle('open', open);
    document.querySelector('.drop-btn')?.setAttribute('aria-expanded', String(open));
  };
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.drop-btn')) set(!document.querySelector('.drop')!.classList.contains('open'));
    else if (!target.closest('.drop')) set(false);
    // le menu mobile se referme quand on touche ailleurs
    const mobile = document.querySelector<HTMLDetailsElement>('details.mobile');
    if (mobile?.open && !target.closest('details.mobile')) mobile.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    set(false);
    const mobile = document.querySelector<HTMLDetailsElement>('details.mobile');
    if (mobile) mobile.open = false;
  });
</script>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; background: #fff; padding: 8px 12px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }
  .site-header { position: fixed; top: 14px; left: 0; right: 0; z-index: 50; pointer-events: none; }
  .bar { pointer-events: auto; position: relative; width: min(100% - 24px, var(--maxw)); margin-inline: auto; min-height: 62px; display: flex; align-items: center; gap: 20px; padding: 8px 8px 8px 24px; border-radius: 999px; background: rgba(255, 255, 255, .94); backdrop-filter: blur(16px) saturate(160%); box-shadow: 0 16px 40px -18px rgba(4, 38, 43, .55), 0 0 0 1px rgba(7, 52, 58, .07); }
  .logo { flex: none; }
  .nav { display: flex; align-items: center; gap: 2px; margin-inline: auto; }
  .nav > a, .drop-btn { font: 600 .95rem var(--font-sans); color: var(--ink); text-decoration: none; padding: 10px 16px; border-radius: 999px; background: none; border: 0; cursor: pointer; transition: background-color .15s ease, color .15s ease; }
  .nav > a:hover, .drop-btn:hover, .drop.open .drop-btn { background: var(--surface-2); color: var(--deep); }
  .nav > a[aria-current] { color: var(--accent); }
  .drop-btn::after { content: ""; display: inline-block; width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-3px); margin-left: 9px; transition: transform .2s ease; }
  .drop.open .drop-btn::after { transform: rotate(225deg) translateY(-1px); }
  .mega { position: absolute; top: calc(100% + 12px); left: 50%; width: min(900px, calc(100vw - 24px)); display: grid; grid-template-columns: 1.75fr 1fr; background: #fff; border-radius: 26px; overflow: hidden; box-shadow: 0 30px 60px -24px rgba(4, 38, 43, .5), 0 0 0 1px rgba(7, 52, 58, .07); opacity: 0; visibility: hidden; transform: translate(-50%, -8px); transition: opacity .2s ease, transform .25s cubic-bezier(.2, .8, .2, 1), visibility .2s; }
  .drop.open .mega, .drop:focus-within .mega { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .mega-col { padding: 22px 16px 16px; }
  .mega-side { padding: 22px 16px 16px; background: var(--tint); border-left: 1px solid var(--border); }
  .mega-title { margin: 0 12px 10px; font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .mega ul { list-style: none; margin: 0; padding: 0; }
  .mega-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .mega a { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border-radius: 16px; text-decoration: none; color: var(--ink); transition: background-color .15s ease; }
  .mega-grid a:hover, .mega-grid a[aria-current] { background: var(--surface-2); }
  .m-ic { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }
  .mega strong { display: block; font-size: .97rem; }
  .mega small { display: block; color: var(--ink-2); font-size: .82rem; line-height: 1.3; }
  .mega-side a { display: block; }
  .mega-side a:hover, .mega-side a[aria-current] { background: rgba(255, 255, 255, .75); }
  .mega-side small { margin-top: 2px; color: var(--accent); font-weight: 600; }
  .cta { min-height: 46px; padding: 9px 20px; font-size: .95rem; flex: none; }
  .mobile { display: none; margin-left: auto; }
  .mobile summary { list-style: none; width: 46px; height: 46px; display: grid; place-items: center; cursor: pointer; border-radius: 50%; background: var(--surface-2); }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile summary span, .mobile summary span::before, .mobile summary span::after { display: block; width: 20px; height: 2px; background: var(--deep); border-radius: 2px; position: relative; content: ""; transition: transform .25s ease, background-color .2s ease; }
  .mobile summary span::before { position: absolute; top: -6px; }
  .mobile summary span::after { position: absolute; top: 6px; }
  .mobile[open] summary { background: var(--deep); }
  .mobile[open] summary span { background: transparent; }
  .mobile[open] summary span::before { top: 0; transform: rotate(45deg); background: #fff; }
  .mobile[open] summary span::after { top: 0; transform: rotate(-45deg); background: #fff; }
  .mobile nav { position: absolute; left: 0; right: 0; top: calc(100% + 8px); background: #fff; border-radius: 24px; padding: 16px; display: grid; gap: 10px; max-height: calc(100vh - 96px); overflow-y: auto; box-shadow: 0 30px 60px -24px rgba(4, 38, 43, .55), 0 0 0 1px rgba(7, 52, 58, .07); }
  .m-title { margin: 4px 4px 0; font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .m-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .m-grid a { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 14px; background: var(--surface-2); color: var(--ink); text-decoration: none; font-weight: 650; font-size: .9rem; }
  .m-grid a[aria-current] { background: var(--accent-soft); color: var(--accent); }
  .m-grid .m-ic { width: 32px; height: 32px; border-radius: 10px; background: #fff; }
  .m-grid a:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .m-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .m-chips a { padding: 7px 12px; border-radius: 999px; border: 1.5px solid var(--border-strong); color: var(--ink); text-decoration: none; font-weight: 600; font-size: .82rem; }
  .m-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--border); }
  .m-links a { text-align: center; padding: 10px 4px; border-radius: 12px; color: var(--deep); text-decoration: none; font-weight: 700; font-size: .92rem; background: var(--tint); }
  .mobile nav .btn { margin-top: 2px; }
  @media (max-width: 900px) {
    .nav, .cta { display: none; }
    .mobile { display: block; }
    .bar { padding-left: 20px; }
  }
  @media (max-width: 640px) {
    .site-header { top: 10px; }
    .bar { min-height: 52px; padding: 5px 5px 5px 16px; width: min(100% - 20px, var(--maxw)); }
    .logo :global(img) { width: 108px; height: auto; }
    .mobile summary { width: 42px; height: 42px; }
  }
</style>

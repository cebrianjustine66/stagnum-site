---
import { FORM_ENDPOINT } from '../data/site';
interface Props { withConfig?: boolean }
const { withConfig = false } = Astro.props;
if (!FORM_ENDPOINT) console.warn('[stagnum] FORM_ENDPOINT est vide : le formulaire de devis ne peut pas envoyer de demande.');
---
<form name="demande-devis" method="POST" action={FORM_ENDPOINT} data-endpoint={FORM_ENDPOINT} class="form">
  <p class="hp"><label>Ne pas remplir : <input name="site-web" tabindex="-1" autocomplete="off" /></label></p>
  {withConfig && <input type="hidden" name="configuration" id="f-configuration" value="" />}
  <div class="row">
    <label>Nom et prénom
      <input name="nom" type="text" autocomplete="name" required />
    </label>
    <label>Société
      <input name="societe" type="text" autocomplete="organization" required />
    </label>
  </div>
  <div class="row">
    <label>Téléphone
      <input name="telephone" type="tel" autocomplete="tel" inputmode="tel" required />
    </label>
    <label>E-mail
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>
  <label>Votre message <span class="opt">(facultatif)</span>
    <textarea name="message" rows="3"></textarea>
  </label>
  <button class="btn btn-primary" type="submit">Envoyer ma demande</button>
  <p class="status" role="alert" hidden></p>
  <p class="small muted legal">Vos informations servent uniquement à répondre à votre demande. Voir notre <a href="/confidentialite/">politique de confidentialité</a>.</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[name="demande-devis"]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const fail = (msg: string) => { status.textContent = msg; status.hidden = false; button.disabled = false; };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const endpoint = form.dataset.endpoint;
      if (!endpoint) return fail('L’envoi n’est pas encore activé sur ce site.');
      button.disabled = true;
      try {
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/merci/';
      } catch {
        fail('L’envoi a échoué. Réessayez dans un instant.');
      }
    });
  });
</script>

<style>
  .form { display: grid; gap: 16px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .95rem; }
  input, textarea {
    font: 400 1rem var(--font-sans); color: var(--ink); background: var(--surface);
    border: 1.5px solid var(--border-strong); border-radius: var(--radius-sm); padding: 12px 14px; width: 100%; min-height: 48px;
  }
  input:focus, textarea:focus { outline: 3px solid var(--aqua); outline-offset: 1px; border-color: var(--accent); }
  .opt { font-weight: 400; color: var(--ink-2); }
  .hp { position: absolute; left: -9999px; }
  .legal { margin: 0; }
  .status { margin: 0; color: #C23A52; font-weight: 600; }
  button { justify-self: start; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>

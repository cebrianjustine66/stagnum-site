---
// Démonstration animée d'une brique. Les noms et les montants sont des exemples.
// Le script fait avancer une progression de 0 à 1 et révèle chaque élément à son seuil (data-at).
import Icon from './Icon.astro';
import BrickMini from './BrickMini.astro';
import { BRICKS } from '../data/pricing';
interface Props { id: string; home?: boolean }
const { id, home = false } = Astro.props;
const brick = BRICKS.find((b) => b.id === id)!;
// Sur l'accueil, le téléphone montre ce qui s'est fait tout seul dans la journée.
const alerts = [
  { icon: 'chantiers', t: 'Chantier Bernard', v: 'Marge 42 %' },
  { icon: 'factures', t: 'Facture en retard', v: 'Relance envoyée' },
  { icon: 'inventaire', t: 'Stock', v: 'Mis à jour' },
];
const gauges = [
  { l: 'pH', v: 7.8, dec: 1, pos: 85.7, zl: 28.6, zw: 28.6, ok: false },
  { l: 'Chlore libre', v: 0.5, dec: 1, pos: 16.7, zl: 33.3, zw: 33.3, ok: false },
  { l: 'TAC', v: 90, dec: 0, pos: 45, zl: 40, zw: 35, ok: true },
  { l: 'Stabilisant', v: 35, dec: 0, pos: 35, zl: 20, zw: 30, ok: true },
];
const steps = ['Créée', 'Envoyée', 'Relancée', 'Payée'];
---
<div class="demo" data-demo={id}>
  <div class="devices" role="img" aria-label="Démonstration animée de Stagnum sur ordinateur et sur téléphone, avec des données d’exemple.">
  <div class="laptop" aria-hidden="true">
  <div class="lid">
  <span class="cam"></span>
  <div class="view">
  <div class="screen">
    <div class="app-side">
      <span class="app-logo"></span>
      {BRICKS.map((b) => <span class={`app-nav ${b.id === id ? 'on' : ''}`}><Icon name={b.id} size={16} /></span>)}
    </div>
    <div class="app-main">
    <div class="app-top"><strong>{brick.name}</strong><span class="app-search">Rechercher</span><span class="app-user"></span></div>
    <div class="inner">
      {id === 'devis' && (
        <>
          <div class="said"><span class="mic pen"></span><p><span data-type data-from="0" data-to="0.34">Devis pour Madame Martin : liner 8 par 4 et une pompe à chaleur.</span><i class="caret"></i></p></div>
          <div class="head" data-at="0.36"><div><small>Devis D-0142</small><strong>Mme Martin · bassin 8 × 4</strong></div><span class="stamp" data-at="0.82">PRÊT ✓</span></div>
          <div class="lines">
            <div class="line" data-at="0.42" data-val="3180"><span>Liner armé 8 × 4 m</span><b>3 180 €</b></div>
            <div class="line" data-at="0.54" data-val="2450"><span>Pompe à chaleur</span><b>2 450 €</b></div>
            <div class="line" data-at="0.66" data-val="960"><span>Pose et mise en eau</span><b>960 €</b></div>
          </div>
          <div class="total"><span>Total HT</span><b data-total>0 €</b></div>
        </>
      )}
      {id === 'factures' && (
        <>
          <div class="head on"><div><small>Facture F-0221</small><strong class="big">3 480 €</strong></div><span class="status" data-status="Brouillon|Envoyée|Relancée|Payée ✓">Brouillon</span></div>
          <div class="rail"><i data-stepfill></i></div>
          <div class="steps">
            {steps.map((s, i) => <div class="step" data-step={i}><span>{i + 1}</span><em>{s}</em></div>)}
          </div>
          <div class="lines push">
            <div class="line" data-at="0.5"><span>Relance envoyée toute seule</span><b>à 7 jours, votre réglage</b></div>
            <div class="line" data-at="0.66"><span>Facture électronique</span><b>Transmise</b></div>
            <div class="dark" data-at="0.86"><span>Camping du Lac</span><b>Payée</b></div>
          </div>
        </>
      )}
      {id === 'achats' && (
        <>
          <div class="doc">
            <span class="sheet"><i></i><i></i><i></i><i></i><b class="scan"></b></span>
            <div><small>Bon de livraison déposé</small><strong>BL n° 4471 · 3 lignes</strong></div>
            <span class="stamp" data-at="0.34">LU ✓</span>
          </div>
          <div class="lines">
            <div class="line" data-at="0.42" data-val="432"><span>Chlore choc 5 kg <em class="x">× 24</em></span><b>432,00 €</b></div>
            <div class="line" data-at="0.54" data-val="380"><span>Galets 250 g <em class="x">× 40</em></span><b>380,00 €</b></div>
            <div class="line" data-at="0.66" data-val="1180"><span>Robot nettoyeur <em class="x">× 2</em></span><b>1 180,00 €</b></div>
          </div>
          <div class="total"><span>Achat HT</span><b data-total data-dec="2">0,00 €</b></div>
          <div class="dark" data-at="0.86"><span>Rien à retaper</span><b>Stock mis à jour</b></div>
        </>
      )}
      {id === 'chantiers' && (
        <>
          <div class="said"><span class="mic"></span><p><span data-type data-from="0" data-to="0.3">« Chantier Bernard : terrassement terminé, deux heures de plus. »</span><i class="caret"></i></p></div>
          <div class="head" data-at="0.3"><div><small>Chantier Bernard</small><strong>Construction 8 × 4</strong></div><span class="pct"><b data-num="68" data-dec="0">0</b> %</span></div>
          <div class="bar" data-at="0.3"><i data-grow="68"></i></div>
          <div class="lines">
            <div class="line" data-at="0.48"><span>Vendu</span><b>18 400 €</b></div>
            <div class="line" data-at="0.58"><span>Matériaux</span><b>7 950 €</b></div>
            <div class="line" data-at="0.68"><span>Main-d’œuvre</span><b>2 720 €</b></div>
          </div>
          <div class="dark push" data-at="0.82"><span>Marge du chantier</span><b>7 730 € · 42 %</b></div>
        </>
      )}
      {id === 'caisse' && (
        <>
          <div class="head on"><div><small>Vente au comptoir</small><strong>Mme Martin · bassin 8 × 4</strong></div><span class="stamp" data-at="0.8">PAYÉ ✓</span></div>
          <div class="lines">
            <div class="line" data-at="0.14" data-val="34.9"><span>Chlore choc 5 kg</span><b>34,90 €</b></div>
            <div class="line" data-at="0.28" data-val="12.5"><span>Bandelettes d’analyse</span><b>12,50 €</b></div>
            <div class="line" data-at="0.42" data-val="18"><span>Brosse de paroi</span><b>18,00 €</b></div>
          </div>
          <div class="total"><span>À encaisser</span><b data-total data-dec="2">0,00 €</b></div>
          <div class="dark push" data-at="0.9"><span>Stock mis à jour</span><b>3 articles</b></div>
        </>
      )}
      {id === 'inventaire' && (
        <>
          <div class="said"><span class="mic"></span><p><span data-type data-from="0" data-to="0.38">« Chlore choc cinq kilos : douze seaux. Galets : huit. Deux robots. »</span><i class="caret"></i></p></div>
          <div class="lines">
            <div class="line" data-at="0.3"><span>Chlore choc 5 kg</span><b class="qty"><i data-num="12" data-dec="0" data-from="0.3">0</i><em class="pill ok" data-at="0.5">En stock</em></b></div>
            <div class="line" data-at="0.44"><span>Galets 250 g</span><b class="qty"><i data-num="8" data-dec="0" data-from="0.44">0</i><em class="pill warn" data-at="0.64">À commander</em></b></div>
            <div class="line" data-at="0.58"><span>Robots en exposition</span><b class="qty"><i data-num="2" data-dec="0" data-from="0.58">0</i><em class="pill ok" data-at="0.74">En stock</em></b></div>
          </div>
          <div class="dark push" data-at="0.86"><span>Inventaire à jour</span><b>3 références</b></div>
        </>
      )}
      {id === 'eau' && (
        <>
          <div class="head on"><div><small>Analyse du jour</small><strong>Bassin Petit · 48 m³</strong></div></div>
          <div class="gauges">
            {gauges.map((g) => (
              <div class="gauge">
                <div class="g-top"><span>{g.l}</span><span class="g-val"><b data-num={g.v} data-dec={g.dec} data-ease>0</b><em class={`pill ${g.ok ? 'ok' : 'warn'}`} data-at="0.46">{g.ok ? 'Idéal' : 'À corriger'}</em></span></div>
                <div class="track"><i class="zone" style={`left:${g.zl}%;width:${g.zw}%`}></i><i class={`dot ${g.ok ? 'ok' : 'warn'}`} data-pos={g.pos}></i></div>
              </div>
            ))}
          </div>
          <div class="lines push two">
            <div class="dark" data-at="0.64"><span>pH moins</span><b>à valider</b></div>
            <div class="dark" data-at="0.76"><span>Chlore choc</span><b>à valider</b></div>
          </div>
        </>
      )}
    </div>
    </div>
  </div>
  </div>
  </div>
  <div class="base"><span></span></div>
  <div class="ground"></div>
  </div>
  <div class="phone" aria-hidden="true">
    <span class="island"></span>
    <div class="p-screen">
      <div class="status"><b>9:41</b><span><i class="sig"></i><i class="bat"></i></span></div>
      <div class="p-bar"><span class="p-dot"></span>Stagnum</div>
      {home ? (
        <div class="p-panels">
          <ul class="alerts p-panel">
            {alerts.map((a) => <li><span class="a-ic"><Icon name={a.icon} size={15} /></span><div><small>{a.t}</small><strong>{a.v}</strong></div></li>)}
          </ul>
          {/* Un tour sur deux : le pisciniste dicte l'avancement d'un chantier, la fiche se met à jour. */}
          <div class="p-panel p-voice">
            <div class="p-said"><span class="p-mic"></span><p><span data-type data-from="0.04" data-to="0.36">« Chantier Bernard : terrassement fini, deux heures de plus. »</span><i class="caret"></i></p></div>
            <div class="p-card" data-at="0.38">
              <div class="p-row"><span class="a-ic"><Icon name="chantiers" size={15} /></span><div><small>Chantier Bernard</small><strong>Construction 8 × 4</strong></div><b class="p-pct"><i data-num="68" data-dec="0" data-from="0.38">0</i> %</b></div>
              <div class="p-bar2"><i data-grow="68"></i></div>
            </div>
            <div class="p-line" data-at="0.52"><span>Terrassement</span><b class="ok">Terminé ✓</b></div>
            <div class="p-line" data-at="0.62"><span>Main-d’œuvre</span><b>+ 2 h</b></div>
            <div class="p-dark" data-at="0.76"><span>Marge</span><b>42 %</b></div>
          </div>
        </div>
      ) : (
        <>
          <p class="p-title"><Icon name={id} size={15} />{brick.name}</p>
          <BrickMini id={id} />
        </>
      )}
      <p class="p-sync">Synchronisé</p>
      <span class="home"></span>
    </div>
  </div>
  </div>
  <div class="controls">
    <button type="button" class="replay">↻ Rejouer</button>
    <span class="progress" aria-hidden="true"><i></i></span>
  </div>
</div>

<script>
  const SPEED = 7000; // durée d'une lecture, en millisecondes
  const HOLD = 2600; // pause sur l'écran final avant de recommencer
  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const ease = (x: number) => 1 - Math.pow(1 - clamp(x), 3);
  const fr = (n: number, dec: number) => n.toLocaleString('fr-FR', { minimumFractionDigits: dec, maximumFractionDigits: dec }).replace(/ /g, ' ');

  // Le contenu de l'écran est dessiné à largeur fixe (--vw), puis réduit à la largeur réelle de l'ordinateur.
  document.querySelectorAll<HTMLElement>('.view').forEach((view) => {
    const fit = () => view.style.setProperty('--k', String(view.clientWidth / Number(getComputedStyle(view).getPropertyValue('--vw'))));
    fit();
    new ResizeObserver(fit).observe(view);
  });

  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((demo) => {
    const q = <T extends HTMLElement>(s: string) => [...demo.querySelectorAll<T>(s)];
    const typed = q('[data-type]').map((el) => ({ el, text: el.textContent ?? '' }));
    const statusEl = demo.querySelector<HTMLElement>('[data-status]');
    const statuses = statusEl?.dataset.status?.split('|') ?? [];
    const bar = demo.querySelector<HTMLElement>('.progress i')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function render(p: number) {
      q('[data-at]').forEach((el) => el.classList.toggle('on', p >= Number(el.dataset.at)));
      typed.forEach(({ el, text }) => {
        const t = clamp((p - Number(el.dataset.from)) / (Number(el.dataset.to) - Number(el.dataset.from)));
        el.textContent = text.slice(0, Math.floor(t * text.length));
        el.parentElement?.classList.toggle('typing', t > 0 && t < 1);
      });
      q('[data-total]').forEach((el) => {
        const sum = q('[data-val]').reduce((s, l) => s + (p >= Number(l.dataset.at) ? Number(l.dataset.val) : 0), 0);
        el.textContent = fr(sum, Number(el.dataset.dec ?? 0)) + ' €';
      });
      q('[data-num]').forEach((el) => {
        const from = Number(el.dataset.from ?? 0);
        const k = ease((p - from) * (el.dataset.ease !== undefined ? 2.2 : 3.2));
        el.textContent = fr(Number(el.dataset.num) * k, Number(el.dataset.dec ?? 0));
      });
      q('[data-pos]').forEach((el) => { el.style.left = Number(el.dataset.pos) * ease(p * 2.2) + '%'; el.classList.toggle('on', p > 0.46); });
      q('[data-grow]').forEach((el) => { el.style.width = Number(el.dataset.grow) * ease((p - 0.3) * 3.2) + '%'; });
      const step = Math.min(3, Math.floor(p * 4.6));
      q('[data-step]').forEach((el) => {
        const i = Number(el.dataset.step);
        el.classList.toggle('done', i <= step);
        el.classList.toggle('now', i === step);
        el.querySelector('span')!.textContent = i <= step ? '✓' : String(i + 1);
      });
      q('[data-stepfill]').forEach((el) => { el.style.width = (step / 3) * 100 + '%'; });
      if (statusEl) { statusEl.textContent = statuses[step]; statusEl.classList.toggle('paid', step === 3); }
      bar.style.width = clamp(p) * 100 + '%';
    }

    if (reduced) { render(1); return; }

    // Sur l'accueil, le téléphone alterne à chaque tour : résumé de la journée, puis chantier dicté à la voix.
    const phone = demo.querySelector<HTMLElement>('.phone');
    let lap = 0;
    const setLap = (n: number) => { lap = n; phone?.classList.toggle('is-voice', lap % 2 === 1); };

    let start = 0;
    let raf = 0;
    const tick = (now: number) => {
      if (!start) start = now;
      const elapsed = now - start;
      render(elapsed / SPEED);
      if (elapsed > SPEED + HOLD) { start = now; setLap(lap + 1); }
      raf = requestAnimationFrame(tick);
    };
    const play = () => { cancelAnimationFrame(raf); start = 0; setLap(0); raf = requestAnimationFrame(tick); };
    demo.querySelector('.replay')!.addEventListener('click', play);
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) play(); else cancelAnimationFrame(raf);
    }, { threshold: 0.3 }).observe(demo);
    render(0);
  });
</script>

<style>
  .demo { --spring: cubic-bezier(.34, 1.4, .5, 1); color: var(--ink); }
  .devices { position: relative; display: flex; align-items: flex-end; padding-bottom: 18px; }

  /* Ordinateur portable */
  .laptop { position: relative; flex: 1; min-width: 0; margin-right: -52px; }
  .lid { position: relative; background: #10191B; border-radius: 14px 14px 3px 3px; padding: 13px 8px 9px; box-shadow: inset 0 0 0 1.5px #2C3A3D, inset 0 2px 0 rgba(255, 255, 255, .08); }
  .cam { position: absolute; left: 50%; top: 5px; width: 5px; height: 5px; margin-left: -2.500px; border-radius: 50%; background: #2F4246; box-shadow: inset 0 0 0 1px #1B282B; }
  .view { --vw: 560; --vh: 360; position: relative; aspect-ratio: var(--vw) / var(--vh); overflow: hidden; border-radius: 4px; background: #EEF4F3; }
  .screen { position: absolute; left: 0; top: 0; width: calc(var(--vw) * 1px); height: calc(var(--vh) * 1px); display: flex; transform-origin: 0 0; transform: scale(var(--k, .8)); }
  .app-side { flex: none; width: 44px; background: var(--deep); padding: 10px 0; display: grid; gap: 5px; align-content: start; justify-items: center; }
  .app-logo { width: 12px; height: 12px; border-radius: 3px; background: var(--sun); transform: rotate(45deg); margin: 4px 0 10px; }
  .app-nav { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; color: #6FA5A8; }
  .app-nav.on { background: rgba(255, 255, 255, .16); color: #fff; }
  .app-main { flex: 1; min-width: 0; padding: 10px 74px 10px 14px; display: flex; flex-direction: column; gap: 8px; }
  .app-top { display: flex; align-items: center; gap: 10px; }
  .app-top strong { font: 750 .98rem var(--font-display); letter-spacing: -.01em; color: var(--deep); }
  .app-search { margin-left: auto; font-size: .68rem; color: #8FA5A4; background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 4px 26px 4px 10px; }
  .app-user { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, #F59068, var(--sun)); }
  .base { position: relative; height: 11px; margin: 0 -9%; border-radius: 2px 2px 12px 12px; background: linear-gradient(180deg, #F2F6F5 0%, #D5DFDE 28%, #AEBDBC 100%); box-shadow: inset 0 1px 0 #fff, inset 0 -2px 3px rgba(0, 0, 0, .18); }
  .base span { position: absolute; left: 50%; top: 0; width: 17%; height: 5px; margin-left: -8.500%; border-radius: 0 0 7px 7px; background: linear-gradient(180deg, #9FAEAD, #C3CECD); }
  .ground { position: absolute; left: -4%; right: -4%; bottom: -16px; height: 22px; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(4, 38, 43, .5), transparent 70%); filter: blur(4px); z-index: -1; }

  /* Téléphone */
  .phone { position: relative; z-index: 2; flex: none; width: 156px; margin-bottom: -16px; border-radius: 30px; padding: 5px; background: #10191B; box-shadow: inset 0 0 0 1.5px #3A4A4D, 0 26px 36px -14px rgba(4, 38, 43, .75), 0 6px 10px -4px rgba(4, 38, 43, .5); }
  .phone::before { content: ""; position: absolute; right: -2px; top: 84px; width: 3px; height: 38px; border-radius: 2px; background: #1E2B2E; }
  .phone::after { content: ""; position: absolute; left: -2px; top: 66px; width: 3px; height: 22px; border-radius: 2px; background: #1E2B2E; box-shadow: 0 30px 0 #1E2B2E; }
  .island { position: absolute; left: 50%; top: 11px; width: 42px; height: 12px; margin-left: -21px; border-radius: 8px; background: #10191B; z-index: 2; }
  .p-screen { position: relative; border-radius: 25px; background: #EEF4F3; padding: 8px 8px 16px; display: grid; gap: 8px; min-height: 308px; align-content: start; }
  .status { display: flex; justify-content: space-between; align-items: center; padding: 1px 8px 8px; font-size: .56rem; color: var(--ink); }
  .status span { display: flex; align-items: center; gap: 4px; }
  .sig { width: 11px; height: 7px; background: linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 3px, var(--ink) 3px 5px, transparent 5px 6px, var(--ink) 6px 8px, transparent 8px 9px, var(--ink) 9px 11px); -webkit-mask: linear-gradient(to top right, #000 50%, transparent 50%); mask: linear-gradient(to top right, #000 50%, transparent 50%); }
  .bat { position: relative; width: 16px; height: 8px; border-radius: 2.500px; border: 1px solid var(--ink); }
  .bat::before { content: ""; position: absolute; inset: 1px; right: 4px; border-radius: 1px; background: var(--ink); }
  .home { position: absolute; left: 50%; bottom: 5px; width: 44px; height: 3px; margin-left: -22px; border-radius: 3px; background: #10191B; opacity: .8; }
  .p-bar { display: flex; align-items: center; gap: 6px; font: 750 .78rem var(--font-display); color: var(--deep); padding: 0 4px 2px; }
  .p-dot { width: 7px; height: 7px; border-radius: 2px; background: var(--sun); transform: rotate(45deg); }
  .p-title { margin: 0; display: flex; align-items: center; gap: 6px; font: 700 .8rem var(--font-display); color: var(--accent); padding: 0 4px; }
  .phone :global(.mini) { padding: 8px 9px; gap: 6px; font-size: .62rem; border-radius: 10px; box-shadow: 0 6px 14px -10px rgba(7, 52, 58, .5); }
  .phone :global(.mini .pill) { font-size: .54rem; padding: 2px 6px; }
  /* Le téléphone est étroit : on y masque le détail (numéro de facture, conditionnement) pour garder une ligne par élément. */
  .phone :global(.mini .ref) { display: none; }
  .phone :global(.mini .row span) { white-space: nowrap; }
  .phone :global(.mini .gauge) { grid-template-columns: 30px 1fr 22px; gap: 6px; }
  .alerts { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .alerts li { display: flex; align-items: center; gap: 7px; background: #fff; border-radius: 10px; padding: 7px; box-shadow: 0 6px 14px -10px rgba(7, 52, 58, .5); }
  .a-ic { flex: none; width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }
  .alerts small { display: block; font-size: .56rem; color: var(--ink-2); line-height: 1.2; }
  .alerts strong { font-size: .66rem; line-height: 1.2; white-space: nowrap; }
  /* Les deux écrans du téléphone sont superposés ; on passe de l'un à l'autre en fondu. */
  .p-panels { display: grid; }
  .p-panel { grid-area: 1 / 1; transition: opacity .45s, transform .55s var(--spring); }
  .p-voice { display: grid; gap: 6px; align-content: start; opacity: 0; transform: translateY(8px); pointer-events: none; }
  .phone.is-voice .alerts { opacity: 0; transform: translateY(-8px); }
  .phone.is-voice .p-voice { opacity: 1; transform: none; }

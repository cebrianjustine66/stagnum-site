---
// Blocs ajoutés depuis l'interface d'édition, affichés les uns sous les autres.
// Les data-ed-* repèrent les blocs pour l'éditeur visuel (/edition), sans effet sur l'affichage.
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import Cta from './Cta.astro';
import Team from './Team.astro';
import { rich, type Block } from '../lib';
interface Props { blocks?: Block[] }
const { blocks = [] } = Astro.props;
const bg = { clair: '', sable: 'sandy', fonce: 'on-deep water' };
const hl = (b: { background?: keyof typeof bg }) => (b.background === 'fonce' ? 'hl' : 'hl hl-ink');
// Classes de mise en page communes : fond et espacement.
const box = (b: { background?: keyof typeof bg; spacing?: string }) => `block ${bg[b.background ?? 'clair'] ?? ''} sp-${b.spacing ?? 'normal'}`;
const COLS = ['c1', 'c2', 'c3', 'c4'] as const;
const colsOf = (n?: string) => COLS.slice(0, Math.min(4, Math.max(2, Number(n) || 3)));
const calloutLabels = { conseil: 'Bon à savoir', attention: 'Attention', exemple: 'Exemple' };
const stepColors = ['#1799A1', '#EC7F51', '#0B3D42'];
// Mêmes teintes que les cartes des briques de l'accueil.
const cardColors = [['#0F5358', 'dark'], ['#E1F3F1', ''], ['#FBE6D2', '']];
const paragraphs = (t: string) => t.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<div data-ed-blocks style="display: contents">
{blocks.map(({ discriminant: type, value: b }, index) => (
  <div data-ed-block={index} style="display: contents">
    {type === 'texte' && (
      <section class={box(b)}>
        <div class={`wrap reveal ${b.width === 'large' ? '' : 'narrow'} ${b.align === 'centre' ? 'center' : ''}`}>
          {b.title && <h2 set:html={rich(b.title, hl(b))} />}
          {paragraphs(b.text).map((p) => <p class="lead" set:html={rich(p)} />)}
        </div>
      </section>
    )}
    {type === 'liste' && (
      <section class={box(b)}>
        <div class={`wrap split-list reveal lay-${b.layout ?? 'gauche'}`}>
          <div>
            {b.title && <h2 set:html={rich(b.title, hl(b))} />}
            {b.intro && <p class="lead" set:html={rich(b.intro)} />}
          </div>
          <ul class="checks">
            {b.items.map((item) => <li set:html={rich(item)} />)}
          </ul>
        </div>
      </section>
    )}
    {type === 'cartes' && (
      <section class={box(b)}>
        <div class="wrap">
          {b.title && <h2 class="center" set:html={rich(b.title, hl(b))} />}
          <div class={`grid cols cols-${colsOf(b.columns).length}`}>
            {b.cards.map((c, i) => {
              const Tag = c.href ? 'a' : 'div';
              const [color, tone] = cardColors[i % 3];
              return (
                <Tag class={`card tint reveal ${tone}`} style={`--tint:${color}`} href={c.href || undefined}>
                  <span class="ghost" aria-hidden="true"><Icon name={c.icon} size={150} /></span>
                  <span class="tint-top">
                    <span class="tile"><Icon name={c.icon} size={24} /></span>
                    <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  </span>
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                  {c.href && <span class="go"><Icon name="arrow" size={18} /></span>}
                </Tag>
              );
            })}
          </div>
        </div>
      </section>
    )}
    {type === 'etapes' && (
      <section class={box(b)}>
        <div class="wrap">
          {b.title && <h2 class="center" set:html={rich(b.title, hl(b))} />}
          <ol class="steps" style={`--n:${b.steps.length}`}>
            {b.steps.map((s, i) => (
              <li class="reveal" style={`--c:${stepColors[i % 3]}`}>
                <span class="n">{i + 1}</span>
                <h3>{s.title}</h3>
                <p set:html={rich(s.text)} />
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
    {type === 'tableau' && (
      <section class={box(b)}>
        <div class="wrap reveal">
          {(b.title || b.intro) && (
            <div class="center tb-head">
              {b.title && <h2 set:html={rich(b.title, hl(b))} />}
              {b.intro && <p class="lead" set:html={rich(b.intro)} />}
            </div>
          )}
          <div class="tb-wrap">
            <table class="tb">
              <thead><tr>{colsOf(b.columns).map((c) => <th set:html={rich(b.head?.[c] ?? '')} />)}</tr></thead>
              <tbody>
                {(b.rows ?? []).map((r) => (
                  <tr>{colsOf(b.columns).map((c) => <td data-label={b.head?.[c] ?? ''} set:html={rich(r[c] ?? '')} />)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )}
    {type === 'encadre' && (
      <section class={`block sp-${b.spacing ?? 'normal'}`}>
        <div class={`wrap reveal ${b.width === 'large' ? '' : 'narrow'}`}>
          <aside class={`callout callout-${b.style ?? 'conseil'}`}>
            <p class="callout-title">{b.title || calloutLabels[b.style ?? 'conseil']}</p>
            {paragraphs(b.text ?? '').map((p) => <p set:html={rich(p)} />)}
          </aside>
        </div>
      </section>
    )}
    {type === 'equipe' && (
      <section class="block sandy crew">
        <div class="wrap">
          <div class="center crew-head reveal">
            {b.title && <h2 set:html={rich(b.title, 'hl hl-ink')} />}
            {paragraphs(b.text).map((p) => <p class="lead" set:html={rich(p)} />)}
          </div>
          <Team />
          {b.button && b.href && <p class="center crew-more"><a class="btn btn-ghost" href={b.href}>{b.button} <Icon name="arrow" size={18} /></a></p>}
        </div>
      </section>
    )}
    {type === 'cta' && <Cta title={b.title || undefined} />}
    {type === 'faq' && <Faq items={b.items} title={b.title || undefined} />}
  </div>
))}
</div>

<style>
  .narrow { max-width: 820px; }
  .center { text-align: center; }
  .center .lead { margin-inline: auto; }
  /* Espacement réglable de chaque bloc. */
  .block.sp-serre { padding-block: clamp(28px, 4vw, 44px); }
  .block.sp-aere { padding-block: clamp(84px, 11vw, 140px); }
  /* Liste : disposition réglable. */
  .split-list.lay-droite > div:first-child { order: 2; }
  .split-list.lay-empile { grid-template-columns: 1fr; gap: 20px; max-width: 820px; }
  /* Cartes : 2, 3 ou 4 par ligne. */
  .cols { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); }
  .cols-2 { --cols: 2; } .cols-3 { --cols: 3; } .cols-4 { --cols: 4; }
  @media (max-width: 1000px) { .cols-4 { --cols: 2; } }
  /* Tablette : trois cartes côte à côte débordent, on les empile. */
  @media (max-width: 1000px) { .cols-3 { --cols: 1; max-width: 640px; margin-inline: auto; } }
  @media (max-width: 720px) { .cols { --cols: 1; } }
  /* Tableau : un vrai tableau sur ordinateur, des fiches sur téléphone. */
  .tb-head { margin-bottom: 28px; }
  .tb-wrap { overflow-x: auto; background: #fff; border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--lift); }
  .tb { width: 100%; border-collapse: collapse; font-size: 1rem; line-height: 1.5; color: var(--ink); }
  .tb th, .tb td { text-align: left; padding: 15px 20px; vertical-align: top; border-bottom: 1px solid var(--border); }
  .tb thead th { background: var(--accent); color: #fff; font-weight: 700; font-size: .92rem; border-bottom: 0; }
  .tb tbody tr:last-child > * { border-bottom: 0; }
  .tb tbody tr:nth-child(even) > * { background: #F4FAF9; }
  .tb tbody td:first-child { font-weight: 650; }
  @media (max-width: 720px) {
    .tb-wrap { background: none; border: 0; box-shadow: none; overflow: visible; }
    .tb thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .tb, .tb tbody { display: grid; gap: 10px; }
    .tb tbody tr { display: block; background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
    .tb tbody tr:nth-child(even) > * { background: transparent; }
    .tb tbody td { display: block; padding: 9px 14px; }
    .tb tbody td[data-label]:not([data-label=""])::before { content: attr(data-label); display: block; margin-bottom: 2px; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
    .tb tbody td:first-child { background: var(--accent-soft) !important; }
  }
  /* Encadré : trois styles. */
  .callout { padding: 26px 30px; border-radius: 22px; border-left: 6px solid var(--accent); background: var(--accent-soft); color: var(--ink); font-size: 1.08rem; line-height: 1.65; }
  .callout p { margin: 0; }
  .callout p + p { margin-top: .65em; }
  .callout .callout-title { margin-bottom: .5em; font: 750 .85rem var(--font-display); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .callout-attention { background: var(--sun-soft); border-left-color: var(--sun); }
  .callout-attention .callout-title { color: #B4501F; }
  .callout-exemple { background: var(--sand); border-left-color: var(--deep); }
  .callout-exemple .callout-title { color: var(--deep); }
  .block h2 { margin-bottom: 20px; }
  .block h2.center { margin-bottom: 32px; }
  .block .lead { max-width: none; }
  .block .lead + .lead, .block .lead + .checks { margin-top: 18px; }
  /* Liste : titre et texte à gauche, coches à droite. */
  .split-list { display: grid; grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: center; }
  .split-list .checks { gap: 0; }
  .split-list .checks li { padding-top: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border); font-weight: 600; }
  .on-deep .split-list .checks li { border-color: rgba(255, 255, 255, .16); }
  .split-list .checks li:last-child { border-bottom: 0; }
  .split-list .checks li::before { top: calc(16px + .15em); }
  @media (max-width: 860px) { .split-list { grid-template-columns: 1fr; gap: 24px; } }
  .block .card h3 { font-size: 1.25rem; margin-bottom: 8px; }
  .block .card p { margin: 0; }
  .block .tint { position: relative; overflow: hidden; background: var(--tint); border-color: rgba(11, 61, 66, .08); border-radius: 28px; padding: 30px 28px 34px; color: var(--ink); }
  .block .tint-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; position: relative; }
  .block .tint .num { font: 700 .95rem var(--font-display); letter-spacing: .06em; opacity: .5; }
  .block .tint .tile { width: 56px; height: 56px; border-radius: 17px; background: #fff; color: var(--accent); margin-bottom: 0; box-shadow: 0 8px 18px -10px rgba(7, 52, 58, .35); position: relative; transition: transform .4s cubic-bezier(.34, 1.6, .5, 1); }
  .block .tint:hover .tile { transform: scale(1.1) rotate(-6deg); }
  .block .tint h3 { font-size: 1.45rem; letter-spacing: -.02em; position: relative; }
  .block .tint p { position: relative; color: var(--ink-2); line-height: 1.6; }
  .block .tint .ghost { position: absolute; right: -28px; bottom: -34px; opacity: .09; color: var(--deep); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .block .tint:hover .ghost { transform: translate(-8px, -8px) rotate(-8deg); }
  .block .tint.dark { color: #fff; border-color: transparent; }
  .block .tint.dark .tile { background: rgba(255, 255, 255, .16); color: #fff; box-shadow: none; }
  .block .tint.dark h3 { color: #fff; }
  .block .tint.dark p { color: #E6F5F5; }
  .block .tint.dark .ghost { color: #fff; opacity: .1; }
  .block .tint .go { position: absolute; bottom: 26px; right: 28px; opacity: .6; }
  .block .card { transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
  .block .card:hover { transform: translateY(-5px); box-shadow: var(--lift-hover); border-color: var(--aqua); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 28px; position: relative; }
  .steps::before { content: ""; position: absolute; left: 12%; right: 12%; top: 31px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, #1799A1, #EC7F51 50%, #0B3D42); opacity: .35; }
  .steps li { position: relative; text-align: center; padding: 0 8px; }
  .steps .n { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 20px; background: var(--c); color: #fff; font: 800 1.6rem var(--font-display); border: 6px solid var(--bg); box-shadow: 0 14px 24px -12px var(--c); transition: transform .4s cubic-bezier(.34, 1.6, .5, 1); }
  .steps li:hover .n { transform: scale(1.12) rotate(-6deg); }
  .steps h3 { font-size: 1.3rem; margin-bottom: 8px; }
  .steps p { margin: 0 auto; max-width: 34ch; color: var(--ink-2); line-height: 1.6; }

  .crew-head { margin-bottom: 36px; }
  .crew-head .lead { margin-inline: auto; max-width: 62ch; }
  .crew-more { margin: 40px 0 0; }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 22px; }
    .steps::before { display: none; }
    .steps li { display: grid; grid-template-columns: 52px 1fr; column-gap: 16px; text-align: left; padding: 0; }
    .steps .n { width: 52px; height: 52px; font-size: 1.25rem; margin: 0; grid-row: span 2; border-width: 4px; }
    .steps h3 { font-size: 1.12rem; margin-bottom: 4px; align-self: end; }
    .steps p { margin: 0; max-width: none; font-size: .95rem; }
  }
</style>

---
import Icon from './Icon.astro';
import c from '../content/commun.json';
import { plain } from '../lib';
interface Props { title?: string }
const { title = c.cta.title } = Astro.props;
---
<section class="cta-section">
  <div class="wrap">
    <div class="cta on-deep water center reveal">
      <h2>{title}</h2>
      <p class="lead">{plain(c.cta.lead)}</p>
      <div class="btns">
        <a class="btn btn-primary" href="/demande-de-devis/?demo=1">{c.buttons.demo} <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="/tarifs/">{c.buttons.price}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { padding: clamp(24px, 4vw, 48px) 0 clamp(64px, 9vw, 112px); }
  .cta { border-radius: 36px; padding: clamp(44px, 7vw, 84px) clamp(22px, 5vw, 64px); box-shadow: 0 40px 70px -40px rgba(7, 52, 58, .6); }
  /* Du bleu nuit au turquoise du logo, pour ne pas répéter le fond des hauts de page. */
  .cta.water { background: radial-gradient(620px 380px at 92% 0%, rgba(255, 255, 255, .16), transparent 62%), radial-gradient(520px 360px at 0% 100%, rgba(5, 42, 48, .5), transparent 60%), linear-gradient(120deg, #0B3D42 0%, #0F5358 38%, #14909A 100%); }
  .cta h2 { max-width: 22ch; margin-inline: auto; }
  @media (max-width: 640px) {
    .cta-section { padding: 16px 0 56px; }
    .cta { border-radius: 24px; padding: 34px 20px; }
  }
</style>

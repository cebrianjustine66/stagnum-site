---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';
import { TRIAL_DAYS } from '../data/pricing';
import { POSTS } from '../data/posts';
const { frontmatter: fm, headings = [] } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).href;
const fmtDate = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const toc = headings.filter((h: any) => h.depth === 2);
const others = POSTS.filter((p) => p.frontmatter.h1 !== fm.h1);
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: fm.h1,
  description: fm.description,
  datePublished: fm.date,
  dateModified: fm.updated ?? fm.date,
  inLanguage: 'fr-FR',
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---
<Base
  title={fm.title}
  description={fm.description}
  type="article"
  breadcrumbs={[{ name: 'Blog', href: '/blog/' }, { name: fm.h1, href: Astro.url.pathname }]}
  jsonld={[article]}
>
  <PageHero crumbs={[{ name: 'Blog', href: '/blog/' }]} title={fm.h1} lead={fm.description}>
    <p class="a-meta">
      <span class="a-tag">{fm.tag}</span>
      <span><Icon name="horloge" size={16} /> {fm.minutes} min de lecture</span>
      <span>Publié le <time datetime={fm.date}>{fmtDate(fm.date)}</time></span>
    </p>
  </PageHero>

  <div class="wrap a-layout">
    <article class="article-body">
      <slot />
    </article>
    <aside class="a-side">
      {toc.length > 0 && (
        <nav class="toc" aria-label="Dans cet article">
          <p class="s-title">Dans cet article</p>
          <ol>
            {toc.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="s-cta" data-water>
        <p class="big">Moins de saisie, plus de piscines.</p>
        <p>Essayez Stagnum gratuitement pendant {TRIAL_DAYS} jours.</p>
        <a class="btn btn-primary" href="/tarifs/">Calculer mon tarif</a>
      </div>
    </aside>
  </div>

  {others.length > 0 && (
    <section class="more-posts">
      <div class="wrap">
        <h2>À lire aussi</h2>
        <div class="grid grid-2">
          {others.map((p) => (
            <a class="o-post reveal" href={p.url} style={`--c:${p.frontmatter.color}`}>
              <span class="o-ic"><Icon name={p.frontmatter.icon} size={28} /></span>
              <span><small>{p.frontmatter.tag} · {p.frontmatter.minutes} min</small><strong>{p.frontmatter.h1}</strong></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <Cta />
</Base>

<style>
  .a-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 22px 0 0; font-size: .92rem; color: #EAF9F9; }
  .a-meta span { display: inline-flex; align-items: center; gap: 6px; }
  .a-tag { padding: 5px 14px; border-radius: 999px; background: var(--sun); color: #2A1206; font-weight: 700; }
  .a-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; align-items: start; padding-block: 24px clamp(48px, 7vw, 80px); }
  .a-side { position: sticky; top: 104px; display: grid; gap: 18px; }
  .toc { background: #fff; border: 1px solid var(--border); border-radius: 22px; padding: 22px; box-shadow: var(--lift); }
  .s-title { margin: 0 0 12px; font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .toc ol { margin: 0; padding: 0; list-style: none; counter-reset: t; display: grid; gap: 10px; }
  .toc li { counter-increment: t; display: flex; gap: 10px; font-size: .93rem; line-height: 1.35; }
  .toc li::before { content: counter(t); flex: none; width: 22px; height: 22px; border-radius: 7px; background: var(--accent-soft); color: var(--accent); font-weight: 750; font-size: .78rem; display: grid; place-items: center; }
  .toc a { color: var(--ink); text-decoration: none; font-weight: 550; }
  .toc a:hover { color: var(--accent); text-decoration: underline; }
  .s-cta { border-radius: 22px; padding: 24px; color: #fff; background: var(--grad-deep); }
  .s-cta .big { font: 760 1.35rem/1.15 var(--font-display); letter-spacing: -.02em; margin-bottom: 8px; }
  .s-cta p { color: #EAF9F9; font-size: .95rem; }
  .s-cta .btn { width: 100%; min-height: 46px; margin-top: 6px; }
  .more-posts { padding-top: 0; }
  .more-posts .wrap { border-top: 2px solid var(--deep); padding-top: 36px; }
  .more-posts h2 { margin-bottom: 28px; }
  .o-post { display: flex; align-items: center; gap: 18px; padding: 20px; border-radius: 22px; background: #fff; border: 1px solid var(--border); box-shadow: var(--lift); color: inherit; text-decoration: none; transition: transform .3s cubic-bezier(.2, .8, .2, 1), opacity .7s ease; }
  .o-post.in:hover { transform: translateY(-4px); color: inherit; }
  .o-ic { flex: none; width: 60px; height: 60px; border-radius: 18px; display: grid; place-items: center; background: var(--c); color: var(--deep); }
  .o-post small { display: block; color: var(--ink-2); font-size: .82rem; margin-bottom: 2px; }
  .o-post strong { font: 720 1.15rem/1.2 var(--font-display); letter-spacing: -.015em; }
  @media (max-width: 960px) {
    .a-layout { grid-template-columns: 1fr; gap: 32px; }
    .a-side { position: static; }
    .toc { display: none; }
  }
</style>

<style is:global>
  /* Mise en forme du texte des articles (contenu Markdown). */
  .article-body { font-size: 1.09rem; line-height: 1.72; color: #233B3C; max-width: 720px; }
  .article-body > p:first-child { font-size: 1.28rem; line-height: 1.55; color: var(--ink); font-weight: 500; }
  .article-body h2 { position: relative; margin: 2.2em 0 .7em; padding-left: 22px; font-size: clamp(1.55rem, 3vw, 2rem); scroll-margin-top: 110px; }
  .article-body h2::before { content: ""; position: absolute; left: 0; top: .32em; width: 11px; height: 11px; border-radius: 3px; background: var(--sun); transform: rotate(45deg); }
  .article-body h3 { margin: 1.8em 0 .5em; font-size: 1.25rem; color: var(--accent); }
  .article-body strong { color: var(--ink); }
  .article-body a { color: var(--accent); font-weight: 600; text-decoration-thickness: 2px; text-decoration-color: var(--aqua); }
  .article-body ul, .article-body ol { padding: 0; margin: 0 0 1.2em; list-style: none; display: grid; gap: 10px; }
  .article-body ul > li { position: relative; padding-left: 30px; }
  .article-body ul > li::before { content: ""; position: absolute; left: 4px; top: .62em; width: 9px; height: 9px; border-radius: 50%; background: var(--accent-bright); box-shadow: 0 0 0 4px var(--accent-soft); }
  .article-body ol { counter-reset: n; }
  .article-body ol > li { counter-increment: n; position: relative; padding: 14px 18px 14px 62px; border-radius: 16px; background: #fff; border: 1px solid var(--border); }
  .article-body ol > li::before { content: counter(n); position: absolute; left: 16px; top: 12px; width: 32px; height: 32px; border-radius: 10px; background: var(--sun); color: #2A1206; font: 800 1rem var(--font-display); display: grid; place-items: center; }
  .article-body table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 1.6em 0; font-size: .97rem; line-height: 1.45; background: #fff; border-radius: 18px; overflow: hidden; box-shadow: var(--lift); border: 1px solid var(--border); display: block; overflow-x: auto; }
  .article-body table tbody, .article-body table thead { display: table; width: 100%; table-layout: auto; }
  .article-body th, .article-body td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .article-body thead th { background: var(--accent); color: #fff; font-weight: 700; border: 0; }
  .article-body tr:last-child td { border-bottom: 0; }
  .article-body tbody tr:nth-child(even) td { background: #F4FAF9; }
  /* Le dernier titre (« À retenir ») et sa liste forment un encadré. */
  .article-body h2:last-of-type { margin-bottom: 0; padding: 24px 26px 6px 48px; background: var(--sand); border-radius: 22px 22px 0 0; }
  .article-body h2:last-of-type::before { left: 26px; top: calc(24px + .32em); }
  .article-body h2:last-of-type + ul { margin: 0; padding: 10px 26px 26px; background: var(--sand); border-radius: 0 0 22px 22px; font-weight: 550; }
  .article-body h2:last-of-type + ul > li::before { background: var(--sun); box-shadow: 0 0 0 4px #F6DFC2; }
  @media (max-width: 640px) {
    .article-body { font-size: 1rem; line-height: 1.65; }
    .article-body > p:first-child { font-size: 1.1rem; }
    .article-body h2 { font-size: 1.3rem; padding-left: 18px; }
    .article-body h3 { font-size: 1.08rem; }
    .article-body ol > li { padding: 12px 14px 12px 52px; }
    .article-body ol > li::before { left: 12px; top: 11px; width: 28px; height: 28px; font-size: .9rem; }
    .article-body th, .article-body td { padding: 10px 12px; font-size: .88rem; }
    .article-body h2:last-of-type { padding: 18px 18px 4px 38px; }
    .article-body h2:last-of-type::before { left: 18px; top: calc(18px + .32em); }
    .article-body h2:last-of-type + ul { padding: 8px 18px 18px; }
  }
</style>

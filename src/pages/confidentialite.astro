---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import legal from '../content/legal.json';
import { legalText } from '../data/legal';
import { paragraphs, rich } from '../lib';
const page = legal.privacy;
// Une ligne vide sépare deux paragraphes ; un simple retour à la ligne reste dans le même paragraphe.
const html = (p: string) => rich(legalText(p)).replace(/\n/g, '<br />\n');
---
<Base title={page.seo.title} description={page.seo.description} noindex>
  <PageHero title={page.title} />
  <section style="padding-top:24px">
    <div class="wrap narrow prose">
      {page.sections.map((s) => (
        <>
          <h2>{s.title}</h2>
          {paragraphs(s.text).map((p) => <p set:html={html(p)} />)}
        </>
      ))}
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page introuvable | Stagnum" description="Cette page n’existe pas ou a été déplacée." noindex>
  <PageHero center title="Cette page n’existe pas" lead="Elle a peut-être été déplacée. Repartez de l’accueil ou calculez votre tarif.">
    <div class="btns" style="justify-content:center">
        <a class="btn btn-primary" href="/">Accueil</a>
        <a class="btn btn-ghost" href="/tarifs/">Tarifs</a>
      </div>
  </PageHero>
</Base>

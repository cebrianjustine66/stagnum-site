---
// Connexion de l'équipe pour éditer le site en ligne.
// On saisit le mot de passe d'équipe une fois, puis on retrouve le bouton « Modifier »
// sur chaque page. En local, l'édition est déjà ouverte sans mot de passe.
import { isEditor, onlineEditingConfigured } from '../lib/cms/auth';
export const prerender = false;
const already = isEditor(Astro.cookies);
const configured = onlineEditingConfigured();
const isDev = import.meta.env.DEV;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Connexion — édition du site Stagnum</title>
    <style>
      :root { --teal:#1799A1; --dark:#0B3D42; --ink:#0f172a; --paper:#f6faf9; }
      * { box-sizing:border-box; }
      body { margin:0; min-height:100vh; display:grid; place-items:center; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color:var(--ink); background:var(--paper); padding:1.5rem; }
      .card { width:min(420px, 100%); background:#fff; border:1px solid #e2e8f0; border-radius:18px; padding:1.8rem; box-shadow:0 20px 50px -30px rgba(7,52,58,.5); }
      h1 { font-size:1.3rem; color:var(--dark); margin:.2rem 0 .3rem; }
      p { color:#475569; font-size:.95rem; line-height:1.5; margin:.2rem 0 1.1rem; }
      label { display:block; font-weight:650; font-size:.9rem; margin-bottom:.4rem; }
      input { width:100%; font:inherit; font-size:1rem; padding:.7rem .8rem; border:1.5px solid #cbd5e1; border-radius:10px; }
      input:focus { outline:2px solid var(--teal); border-color:var(--teal); }
      button { width:100%; margin-top:1rem; font:inherit; font-size:1rem; font-weight:650; border:0; border-radius:10px; padding:.75rem; background:var(--teal); color:#fff; cursor:pointer; }
      button:disabled { opacity:.6; cursor:default; }
      .msg { margin-top:.9rem; font-size:.9rem; min-height:1.2em; }
      .msg.err { color:#b4521f; }
      .msg.ok { color:#166534; }
      .note { margin-top:1.2rem; font-size:.82rem; color:#94a3b8; }
      a { color:var(--teal); }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Édition du site</h1>
      {already ? (
        <>
          <p>Vous êtes connecté·e. Le bouton <b>« Modifier »</b> apparaît en haut de chaque page.</p>
          <p><a href="/">Aller sur le site →</a></p>
        </>
      ) : !configured && !isDev ? (
        <p>L’édition en ligne n’est pas encore activée. (Il manque le mot de passe d’équipe côté hébergement.)</p>
      ) : (
        <>
          <p>Entrez le mot de passe d’équipe pour pouvoir modifier les textes et le blog directement sur le site.</p>
          <form id="f">
            <label for="pw">Mot de passe d’équipe</label>
            <input id="pw" name="pw" type="password" autocomplete="current-password" autofocus />
            <button id="btn" type="submit">Se connecter</button>
            <p id="msg" class="msg" aria-live="polite"></p>
          </form>
        </>
      )}
      <p class="note">Réservé à l’équipe Stagnum. En local, l’édition est ouverte sans mot de passe.</p>
    </div>

    <script is:inline>
      const f = document.getElementById('f');
      if (f) {
        const msg = document.getElementById('msg'), btn = document.getElementById('btn'), pw = document.getElementById('pw');
        f.addEventListener('submit', async (e) => {
          e.preventDefault();
          btn.disabled = true; msg.className = 'msg'; msg.textContent = 'Connexion…';
          try {
            const r = await fetch('/api/cms-login', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: pw.value }) });
            if (r.ok) {
              msg.className = 'msg ok'; msg.textContent = 'Connecté·e ✓ redirection…';
              const next = new URLSearchParams(location.search).get('next') || '/';
              setTimeout(() => (location.href = next), 500);
            } else {
              msg.className = 'msg err'; msg.textContent = r.status === 401 ? 'Mot de passe incorrect.' : await r.text();
              btn.disabled = false;
            }
          } catch (err) { msg.className = 'msg err'; msg.textContent = 'Erreur réseau.'; btn.disabled = false; }
        });
      }
    </script>
  </body>
</html>

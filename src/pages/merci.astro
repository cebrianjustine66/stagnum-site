---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import m from '../content/messages.json';
const t = m.thanks;
---
<Base title={t.seo.title} description={t.seo.description} noindex>
  <PageHero center title={t.title} lead={t.lead}>
    <div class="btns" style="justify-content:center"><a class="btn btn-ghost" href="/">{t.button}</a></div>
  </PageHero>
</Base>

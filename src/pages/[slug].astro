---
import Base from '../layouts/Base.astro';
import Voice from '../components/Voice.astro';
import BrickDemo from '../components/BrickDemo.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { LANDINGS, BRIQUE_PAGES, type Landing } from '../data/pages';
import { TRIAL_DAYS } from '../data/pricing';
import { faqLd } from '../lib';

export function getStaticPaths() {
  return LANDINGS.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: Landing };
const others = BRIQUE_PAGES.filter((b) => b.slug !== page.slug);
const stepColors = ['#1799A1', '#EC7F51', '#0B3D42'];
---
<Base
  title={page.title}
  description={page.description}
  breadcrumbs={[{ name: page.nav, href: `/${page.slug}/` }]}
  jsonld={[faqLd(page.faq)]}
>
  <section class="on-deep water wave-bottom hero">
    <div class="wrap hero-grid">
      <div class="copy">
        <nav class="breadcrumb" aria-label="Fil d’Ariane">
          <ol><li><a href="/">Accueil</a></li><li aria-current="page">{page.nav}</li></ol>
        </nav>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <div class="btns">
          <a class="btn btn-primary" href="/tarifs/">Calculer mon tarif <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href="/demande-de-devis/">Essayer <span class="long">{TRIAL_DAYS} jours </span>gratuitement</a>
        </div>
        {page.included && <p class="from"><Icon name="check" size={16} />{page.included}, sans supplément</p>}
      </div>
      {page.brick
        ? <BrickDemo id={page.brick} />
        : page.voice && <Voice said={page.voice.said} done={page.voice.done} />}
    </div>
  </section>

  <section class="what">
    <div class="wrap what-grid">
      <aside class="what-side on-deep water reveal">
        <h2>Ce qu’il fait <span class="hl">pour vous</span></h2>
        <ul class="checks">
          {page.points.map((p) => <li>{p}</li>)}
        </ul>
        <a class="btn btn-primary" href="/tarifs/">Calculer mon tarif <Icon name="arrow" size={18} /></a>
      </aside>
      <ol class="what-steps">
        {page.sections.map((s, i) => (
          <li class="reveal" style={`--c:${stepColors[i % 3]}`}>
            <span class="n">{i + 1}</span>
            <div class="w-card">
              <h3>{s.h2}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Faq items={page.faq} />

  <section class="others">
    <div class="wrap">
      <h2 class="reveal">{page.brick ? 'Les autres briques' : 'Les briques de Stagnum'}</h2>
      <nav class="o-bar reveal" aria-label="Les briques de Stagnum" style={`--n:${others.length}`}>
        {others.map((o) => (
          <a href={`/${o.slug}/`}>
            <Icon name={o.brick!} size={22} />
            <span>{o.nav}</span>
            <i aria-hidden="true"><Icon name="arrow" size={16} /></i>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .hero { padding-top: calc(var(--head) + clamp(32px, 5vw, 56px)); }
  .hero-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 44px; align-items: center; }
  .hero-grid > :only-child { grid-column: 1 / -1; max-width: 820px; }
  h1 { font-size: clamp(2.2rem, 4.8vw, 3.6rem); }
  .from { margin-top: 22px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px 8px 12px; border-radius: 999px; background: rgba(255, 255, 255, .16); border: 1px solid rgba(255, 255, 255, .28); font-size: .92rem; font-weight: 600; color: #fff; }

  .others h2 { font-weight: 760; letter-spacing: -.035em; line-height: 1; }
  .what-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 56px; align-items: start; }
  .what-side { position: sticky; top: 108px; border-radius: 32px; padding: clamp(28px, 4vw, 44px); box-shadow: 0 40px 70px -40px rgba(7, 52, 58, .6); }
  .what-side h2 { font-size: clamp(2rem, 3.8vw, 2.9rem); margin-bottom: 26px; }
  .what-side .checks { margin-bottom: 30px; font-weight: 550; }
  .what-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; position: relative; }
  .what-steps::before { content: ""; position: absolute; left: 27px; top: 28px; bottom: 28px; width: 3px; border-radius: 3px; background: linear-gradient(180deg, #1799A1, #EC7F51 55%, #0B3D42); opacity: .35; }
  .what-steps li { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 20px; align-items: start; }
  .what-steps .n { position: relative; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--c); color: #fff; font: 800 1.35rem var(--font-display); border: 5px solid var(--bg); box-shadow: 0 12px 22px -12px var(--c); transition: transform .4s cubic-bezier(.34, 1.6, .5, 1); }
  .what-steps li:hover .n { transform: scale(1.12) rotate(-6deg); }
  .w-card { position: relative; background: #fff; border-radius: 22px; padding: 26px 28px 26px 32px; border: 1px solid var(--border); box-shadow: var(--lift); overflow: hidden; transition: transform .3s cubic-bezier(.2, .8, .2, 1), box-shadow .3s ease; }
  .w-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--c); }
  .what-steps li:hover .w-card { transform: translateX(6px); box-shadow: var(--lift-hover); }
  .w-card h3 { font-size: 1.35rem; line-height: 1.15; letter-spacing: -.02em; margin-bottom: 8px; }
  .w-card p { margin: 0; color: var(--ink-2); font-size: 1rem; line-height: 1.6; }

  .others { padding-top: 0; }
  .others h2 { font-size: clamp(1.6rem, 3.2vw, 2.3rem); margin-bottom: 24px; }
  .o-bar { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); background: #fff; border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--lift); overflow: hidden; }
  .o-bar a { display: grid; gap: 14px; align-content: space-between; min-height: 132px; padding: 20px 18px; border-right: 1px solid var(--border); color: var(--ink); text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  .o-bar a:last-child { border-right: 0; }
  .o-bar a > :global(svg) { color: var(--accent); }
  .o-bar span { font: 680 1rem/1.2 var(--font-display); letter-spacing: -.01em; }
  .o-bar i { color: var(--ink-2); opacity: .5; transition: transform .2s ease, opacity .2s ease, color .2s ease; }
  .o-bar a:hover { background: var(--deep); color: #fff; }
  .o-bar a:hover > :global(svg) { color: var(--aqua); }
  .o-bar a:hover i { opacity: 1; color: var(--sun); transform: translateX(4px); }
  @media (max-width: 900px) {
    .o-bar { grid-template-columns: 1fr 1fr; }
    .o-bar a { min-height: 0; grid-template-columns: auto 1fr auto; align-items: center; border-bottom: 1px solid var(--border); }
    .o-bar a:nth-child(even) { border-right: 0; }
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .what-grid { grid-template-columns: 1fr; gap: 32px; }
    .what-side { position: static; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: calc(var(--head) + 16px); }
    .hero-grid { gap: 24px; }
    .long { display: none; }
    h1 { font-size: 1.75rem; }
    .hero .btns { margin-top: 16px; }
    .hero .btns { flex-wrap: nowrap; gap: 8px; }
    .hero .btns .btn { flex: 1 1 0; min-width: 0; padding-inline: 8px; font-size: .84rem; white-space: nowrap; }
    .hero .btns .btn :global(svg) { display: none; }
    .from { font-size: .82rem; padding: 6px 12px 6px 10px; }
    .what-side { padding: 22px; border-radius: 22px; }
    .what-side h2 { font-size: 1.6rem; margin-bottom: 16px; }
    .what-side .checks { margin-bottom: 20px; font-size: .93rem; }
    .what-steps { gap: 14px; }
    .what-steps::before { left: 20px; }
    .what-steps li { grid-template-columns: 42px 1fr; gap: 12px; }
    .what-steps .n { width: 42px; height: 42px; font-size: 1.05rem; border-width: 4px; }
    .w-card { padding: 16px 16px 16px 20px; border-radius: 16px; }
    .w-card h3 { font-size: 1.08rem; }
    .w-card p { font-size: .92rem; }
    .others h2 { font-size: 1.3rem; margin-bottom: 14px; }
    .o-bar a { padding: 13px 14px; gap: 10px; }
    .o-bar span { font-size: .88rem; }
  }
</style>

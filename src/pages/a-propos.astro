---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import Blocks from '../components/Blocks.astro';
import Team from '../components/Team.astro';
import p from '../content/a-propos.json';
import { plain, rich, type Block } from '../lib';

const stepColors = ['#1799A1', '#EC7F51', '#0B3D42'];
---
<Base
  title={plain(p.seo.title)}
  description={plain(p.seo.description)}
  breadcrumbs={[{ name: p.breadcrumb, href: '/a-propos/' }]}
>
  <PageHero title={rich(p.hero.title)} lead={plain(p.hero.lead)} />

  <section class="what">
    <div class="wrap what-grid">
      <aside class="what-side on-deep water reveal">
        <h2 set:html={rich(p.story.title)} />
        <ul class="checks">
          {p.story.points.map((x) => <li>{x}</li>)}
        </ul>
        {p.story.button && <a class="btn btn-primary" href={p.story.href}>{p.story.button} <Icon name="arrow" size={18} /></a>}
      </aside>
      <ol class="what-steps">
        {p.story.items.map((s, i) => (
          <li class="reveal" style={`--c:${stepColors[i % 3]}`}>
            <span class="n">{i + 1}</span>
            <div class="w-card">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {p.team.members.length > 0 && (
    <section class="sandy team-section">
      <div class="wrap">
        <div class="center head">
          <h2 set:html={rich(p.team.title, 'hl hl-ink')} />
          {p.team.intro && <p class="lead">{p.team.intro}</p>}
        </div>
        <Team />
      </div>
    </section>
  )}

  {p.values.items.length > 0 && (
    <section>
      <div class="wrap">
        <h2 class="center values-title" set:html={rich(p.values.title, 'hl hl-ink')} />
        <ul class="incl reveal" style={`--n:${Math.min(p.values.items.length, 4)}`}>
          {p.values.items.map((x) => (
            <li>
              <span class="i-ic" style={`--c:${x.color}`}><Icon name={x.icon} size={24} /></span>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Blocks blocks={p.blocks as Block[]} />
  <Cta />
</Base>

<style>
  .what-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 56px; align-items: start; }
  .what-side { position: sticky; top: 108px; border-radius: 32px; padding: clamp(28px, 4vw, 44px); box-shadow: 0 40px 70px -40px rgba(7, 52, 58, .6); }
  .what-side h2 { font-size: clamp(2rem, 3.8vw, 2.9rem); margin-bottom: 26px; }
  .what-side .checks { margin-bottom: 30px; font-weight: 550; }
  .what-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; position: relative; }
  .what-steps::before { content: ""; position: absolute; left: 27px; top: 28px; bottom: 28px; width: 3px; border-radius: 3px; background: linear-gradient(180deg, #1799A1, #EC7F51 55%, #0B3D42); opacity: .35; }
  .what-steps li { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 20px; align-items: start; }
  .what-steps .n { position: relative; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--c); color: #fff; font: 800 1.35rem var(--font-display); border: 5px solid var(--bg); box-shadow: 0 12px 22px -12px var(--c); transition: transform .4s cubic-bezier(.34, 1.6, .5, 1); }
  .what-steps li:hover .n { transform: scale(1.12) rotate(-6deg); }
  .w-card { position: relative; background: #fff; border-radius: 22px; padding: 26px 28px 26px 32px; border: 1px solid var(--border); box-shadow: var(--lift); overflow: hidden; transition: transform .3s cubic-bezier(.2, .8, .2, 1), box-shadow .3s ease; }
  .w-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--c); }
  .what-steps li:hover .w-card { transform: translateX(6px); box-shadow: var(--lift-hover); }
  .w-card h3 { font-size: 1.35rem; line-height: 1.15; letter-spacing: -.02em; margin-bottom: 8px; }
  .w-card p { margin: 0; color: var(--ink-2); font-size: 1rem; line-height: 1.6; }

  .head { margin-bottom: 40px; }
  .values-title { margin-bottom: 32px; }
  .incl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); background: #fff; border-radius: 28px; border: 1px solid var(--border); box-shadow: var(--lift); overflow: hidden; }
  .incl li { padding: 28px 24px; border-right: 1px solid var(--border); transition: background-color .25s ease; }
  .incl li:last-child { border-right: 0; }
  .incl li:hover { background: #F2FAFA; }
  .i-ic { width: 50px; height: 50px; border-radius: 15px; display: grid; place-items: center; background: var(--c); color: var(--deep); margin-bottom: 16px; }
  .incl h3 { font-size: 1.15rem; margin-bottom: 6px; }
  .incl p { margin: 0; color: var(--ink-2); font-size: .93rem; }

  @media (max-width: 900px) {
    .what-grid { grid-template-columns: 1fr; gap: 32px; }
    .what-side { position: static; }
    .incl { grid-template-columns: 1fr 1fr; }
    .incl li { border-bottom: 1px solid var(--border); }
    .incl li:nth-child(even) { border-right: 0; }
  }
  @media (max-width: 640px) {
    .what-side { padding: 22px; border-radius: 22px; }
    .what-side h2 { font-size: 1.6rem; margin-bottom: 16px; }
    .what-steps { gap: 14px; }
    .what-steps::before { left: 20px; }
    .what-steps li { grid-template-columns: 42px 1fr; gap: 12px; }
    .what-steps .n { width: 42px; height: 42px; font-size: 1.05rem; border-width: 4px; }
    .w-card { padding: 16px 16px 16px 20px; border-radius: 16px; }
    .w-card h3 { font-size: 1.08rem; }
    .w-card p { font-size: .92rem; }
    .incl li { padding: 18px 14px; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import MondeDetail from '../components/MondeDetail.astro';
import CmsEditor from '../components/CmsEditor.astro';
import { bySlug } from '../data/mondes';
import { loadPublished } from '../lib/cms/content';
export const prerender = false;
const base = bySlug('au-comptoir');
const monde = await loadPublished('mondes/au-comptoir', base);
---
<Base
  title="Au comptoir : caisse, articles et fichier client | Stagnum"
  description="Au magasin : caisse conforme, catalogue et tarifs, stock à jour, achats fournisseurs, fiche client et bassins. Vous encaissez, le fichier reste au magasin."
  breadcrumbs={[{ name: 'Au comptoir', href: '/au-comptoir/' }]}
>
  <MondeDetail monde={monde} />
  <CmsEditor pageKey="mondes/au-comptoir" base={monde} />
</Base>
